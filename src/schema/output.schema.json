{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/FlowTrain/Signalman/schema/output.schema.json",
  "title": "Signalman JSON output",
  "type": "object",
  "required": ["schemaVersion", "summary", "findings", "corpus", "ruleErrors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "info", "skills", "unreadable", "roots"],
      "additionalProperties": false,
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "skills": { "type": "integer", "minimum": 0 },
        "unreadable": { "type": "array", "items": { "type": "string" } },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind", "present"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "kind": { "type": "string", "enum": ["project", "personal", "explicit"] },
              "present": { "type": "boolean" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "ruleName", "severity", "file", "message", "suggestion", "docs"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "type": "string" },
          "ruleName": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warn", "info"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "suggestion": { "type": "string", "minLength": 1 },
          "docs": { "type": "string" },
          "relatedFiles": { "type": "array", "items": { "type": "string" } },
          "data": { "type": "object" }
        }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["distinctiveness"],
      "additionalProperties": false,
      "properties": {
        "distinctiveness": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["count", "min", "median", "max", "mean", "skills"],
              "additionalProperties": false,
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "min": { "type": "integer" },
                "median": { "type": "integer" },
                "max": { "type": "integer" },
                "mean": { "type": "integer" },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "file", "score"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "file": { "type": "string" },
                      "score": { "type": "integer", "minimum": 0, "maximum": 100 }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "ruleErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "file", "message"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "type": "string" },
          "file": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
